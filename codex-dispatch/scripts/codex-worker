#!/usr/bin/env bash
# Git Bash 和 macOS/Linux 共用的入口，逻辑在同目录的 codex-worker.py。
set -euo pipefail
script=$0
while [ -L "$script" ]; do
  dir="$(CDPATH= cd -P -- "$(dirname -- "$script")" && pwd)"
  target="$(readlink "$script")"
  case "$target" in
    /*) script=$target ;;
    *) script=$dir/$target ;;
  esac
done
dir="$(CDPATH= cd -P -- "$(dirname -- "$script")" && pwd)"

if ! command -v cygpath >/dev/null 2>&1; then
  if command -v python3 >/dev/null 2>&1; then
    exec python3 -I -X utf8 "$dir/codex-worker.py" "$@"
  fi
  exec python -I -X utf8 "$dir/codex-worker.py" "$@"
fi

# Git Bash 只转换工作树和 @文件，其余参数关闭 MSYS 转换，保留 /api/skills 等任务文本。
# Windows 上用 python，避免选到应用商店的 python3 占位程序。
args=("$@")
# 工作树参数的位置：普通 0，--review <工作树> 为 1，--resume <会话ID> <工作树> 为 2。
i=0
case "${args[0]:-}" in
  --review) i=1 ;;
  --resume) i=2 ;;
esac
if [ "${#args[@]}" -gt "$i" ]; then
  args[$i]="$(cygpath -w -- "${args[$i]}")"
fi
# @文件 参数的位置：任务紧跟工作树；--review 的审查角度在基准之后（第 4 个）。
j=$((i + 1))
[ "${args[0]:-}" = "--review" ] && j=3
if [ "${#args[@]}" -gt "$j" ] && [ "${args[$j]:0:1}" = "@" ]; then
  args[$j]="@$(cygpath -w -- "${args[$j]:1}")"
fi
export MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*'
exec python -I -X utf8 "$(cygpath -w "$dir/codex-worker.py")" "${args[@]}"
